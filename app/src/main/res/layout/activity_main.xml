<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg">
    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:paddingStart="24dp"
            android:paddingEnd="20dp"
            android:paddingTop="18dp"
            android:paddingBottom="12dp">
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/app_name"
                    android:fontFamily="serif"
                    android:textSize="25sp"
                    android:letterSpacing="0.04"
                    android:textColor="@color/text_primary" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:text="@string/home_tagline"
                    android:textSize="11sp"
                    android:letterSpacing="0.08"
                    android:textColor="@color/text_secondary" />
            </LinearLayout>
            <LinearLayout
                android:id="@+id/tvAlive"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:background="@drawable/bg_status"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:clickable="true"
                android:focusable="true">
                <View
                    android:id="@+id/dotAlive"
                    android:layout_width="5dp"
                    android:layout_height="5dp"
                    android:background="@drawable/dot_off" />
                <TextView
                    android:id="@+id/tvAliveText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:textSize="11sp"
                    android:maxLines="1"
                    android:textColor="@color/accent" />
            </LinearLayout>
        </LinearLayout>
        <LinearLayout
            android:id="@+id/multiBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="20dp"
            android:layout_marginBottom="8dp"
            android:background="@drawable/bg_multi_bar_accent"
            android:padding="10dp"
            android:gravity="center_vertical"
            android:visibility="gone">
            <TextView
                android:id="@+id/tvMultiCount"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="@color/on_accent"
                android:textSize="13sp" />
            <TextView android:id="@+id/btnMultiCancel" style="@style/Ledger.MultiAction" android:text="@string/add_cancel" />
            <TextView android:id="@+id/btnMultiSelectAll" style="@style/Ledger.MultiAction" android:text="@string/select_all" />
            <TextView android:id="@+id/btnMultiDelete" style="@style/Ledger.MultiAction" android:text="@string/delete" />
        </LinearLayout>
        <ListView
            android:id="@+id/lvBills"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingBottom="12dp"
            android:clipToPadding="false"
            android:divider="@android:color/transparent"
            android:dividerHeight="8dp"
            android:scrollbars="none" />
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingTop="10dp"
            android:paddingBottom="12dp"
            android:background="@color/bg">
            <TextView
                android:id="@+id/btnLedger"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_weight="1"
                android:text="@string/ledger_tab"
                android:textSize="11sp"
                android:textColor="@color/accent"
                android:gravity="center"
                android:drawableTop="@drawable/ic_ledger"
                android:drawableTint="@color/accent"
                android:drawablePadding="3dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:focusable="true" />
            <TextView
                android:id="@+id/btnPie"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_weight="1"
                android:text="@string/stats_tab"
                android:textSize="11sp"
                android:textColor="@color/text_secondary"
                android:gravity="center"
                android:drawableTop="@drawable/ic_chart"
                android:drawableTint="@color/text_secondary"
                android:drawablePadding="3dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:focusable="true" />
            <TextView
                android:id="@+id/btnAdd"
                android:layout_width="0dp"
                android:layout_height="50dp"
                android:layout_weight="1.4"
                android:layout_marginStart="12dp"
                android:paddingHorizontal="16dp"
                android:gravity="center"
                android:background="@drawable/bg_primary_button"
                android:drawableStart="@drawable/ic_plus"
                android:drawableTint="@color/button_text"
                android:drawablePadding="6dp"
                android:text="@string/add_bill"
                android:textSize="14sp"
                android:textColor="@color/button_text"
                android:clickable="true"
                android:focusable="true" />
        </LinearLayout>
    </LinearLayout>
    <TextView
        android:id="@+id/saveFeedback"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="86dp"
        android:paddingHorizontal="20dp"
        android:paddingVertical="13dp"
        android:background="@drawable/bg_primary_button"
        android:drawableStart="@drawable/ic_check"
        android:drawableTint="@color/button_text"
        android:drawablePadding="8dp"
        android:gravity="center"
        android:text="@string/add_saved"
        android:textSize="13sp"
        android:textColor="@color/button_text"
        android:visibility="gone"
        android:accessibilityLiveRegion="polite" />
    <FrameLayout
        android:id="@+id/drawerOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/scrim"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone"
        android:elevation="8dp">
        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:fillViewport="false"
            android:scrollbars="none">
            <LinearLayout
                android:id="@+id/drawerPanel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_sheet"
                android:orientation="vertical"
                android:padding="24dp"
                android:clickable="true">
                <View
                    android:layout_width="32dp"
                    android:layout_height="4dp"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginBottom="18dp"
                    android:background="@drawable/bg_handle" />
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/settings_title"
                    android:textColor="@color/text_primary"
                    android:textSize="20sp"
                    android:textStyle="bold" />
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:layout_marginBottom="12dp"
                    android:text="@string/local_data_note"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp" />
                <TextView
                    android:id="@+id/btnBudgetSettings"
                    style="@style/Ledger.SettingsAction"
                    android:text="@string/budget_title"
                    android:drawableStart="@drawable/ic_wallet" />
                <TextView android:id="@+id/btnDarkMode" style="@style/Ledger.SettingsAction" android:drawableStart="@drawable/ic_theme" />
                <TextView
                    android:id="@+id/btnListener"
                    style="@style/Ledger.SettingsAction"
                    android:text="@string/open_listener"
                    android:drawableStart="@drawable/ic_bell" />
                <TextView
                    android:id="@+id/btnBattery"
                    style="@style/Ledger.SettingsAction"
                    android:text="@string/open_battery"
                    android:drawableStart="@drawable/ic_battery" />
                <TextView
                    android:id="@+id/btnImport"
                    style="@style/Ledger.SettingsAction"
                    android:text="@string/import_bill"
                    android:drawableStart="@drawable/ic_import" />
                <TextView
                    android:id="@+id/btnDebug"
                    style="@style/Ledger.SettingsAction"
                    android:text="@string/raw_noti"
                    android:drawableStart="@drawable/ic_ledger" />
            </LinearLayout>
        </ScrollView>
    </FrameLayout>
    <include layout="@layout/activity_bill_edit" />
    <include layout="@layout/activity_add_bill" />
</FrameLayout>
