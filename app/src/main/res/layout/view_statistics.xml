<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:fillViewport="true"
    android:scrollbars="none">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="6dp"
        android:paddingBottom="20dp"
        android:orientation="vertical">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical">
            <TextView
                android:id="@+id/tvStatsMonth"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="@color/text_primary"
                android:textSize="16sp"
                android:textStyle="bold" />
            <ImageButton
                android:id="@+id/btnStatsPrevMonth"
                style="@style/Ledger.IconButton"
                android:src="@drawable/ic_chevron_left"
                android:contentDescription="@string/previous_month" />
            <ImageButton
                android:id="@+id/btnStatsNextMonth"
                style="@style/Ledger.IconButton"
                android:src="@drawable/ic_chevron_right"
                android:contentDescription="@string/next_month" />
            <ImageButton
                android:id="@+id/btnStatsSettings"
                style="@style/Ledger.IconButton"
                android:src="@drawable/ic_settings"
                android:contentDescription="@string/settings_title" />
        </LinearLayout>
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="@string/stats_heading"
            android:textColor="@color/text_primary"
            android:textSize="22sp"
            android:textStyle="bold" />
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginVertical="14dp"
            android:text="@string/stats_subtitle"
            android:textColor="@color/text_secondary"
            android:textSize="12sp" />
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="20dp">
            <TextView
                android:id="@+id/btnExpense"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:gravity="center"
                android:text="@string/tab_expense"
                android:textSize="14sp"
                android:clickable="true"
                android:focusable="true" />
            <TextView
                android:id="@+id/btnIncome"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:gravity="center"
                android:text="@string/tab_income"
                android:textSize="14sp"
                android:clickable="true"
                android:focusable="true" />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/statisticsData"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">
            <com.lele.ledger.PieChartView android:id="@+id/pie" android:layout_width="match_parent" android:layout_height="240dp" />
            <TextView
                android:id="@+id/tvNoData"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginVertical="20dp"
                android:gravity="center"
                android:text="@string/pie_no_data"
                android:textColor="@color/text_secondary"
                android:textSize="13sp"
                android:visibility="gone" />
            <LinearLayout
                android:id="@+id/boxLegend"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:orientation="vertical" />
            <TextView
                android:id="@+id/tvHint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginVertical="16dp"
                android:textColor="@color/text_secondary"
                android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
