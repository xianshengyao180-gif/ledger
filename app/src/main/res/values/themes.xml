<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Base.Theme.Ledger" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:statusBarColor">@color/bg</item>
        <item name="android:navigationBarColor">@color/bg</item>
        <item name="android:windowLightStatusBar">@bool/light_system_bars</item>
        <item name="colorAccent">@color/accent</item>
        <item name="android:fontFamily">sans</item>
        <item name="android:colorBackground">@color/bg</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
    </style>
    <style name="Theme.Ledger" parent="Base.Theme.Ledger">
        <item name="android:navigationBarColor">#303B29</item>
    </style>
    <style name="Theme.Ledger.Dialog" parent="Theme.AppCompat.DayNight.Dialog.Alert">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:backgroundDimEnabled">true</item>
        <item name="colorAccent">@color/accent</item>
        <item name="android:alertDialogTheme">@style/Theme.Ledger.Dialog.Alert</item>
    </style>
    <style name="Theme.Ledger.Dialog.Alert" parent="Theme.AppCompat.DayNight.Dialog.Alert">
        <item name="android:background">@drawable/bg_card</item>
        <item name="android:backgroundDimAmount">0.6</item>
        <item name="colorAccent">@color/accent</item>
        <item name="android:buttonBarStyle">@style/Theme.Ledger.Dialog.ButtonBar</item>
    </style>
    <style name="Theme.Ledger.Dialog.ButtonBar" parent="Widget.AppCompat.ButtonBar.AlertDialog">
        <item name="android:background">@android:color/transparent</item>
    </style>
</resources>
