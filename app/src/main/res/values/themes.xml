<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Base.Theme.Ledger" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:statusBarColor">@color/bg</item>
        <item name="android:navigationBarColor">@color/bg</item>
        <item name="android:windowLightStatusBar">@bool/light_system_bars</item>
        <item name="colorAccent">@color/accent</item>
        <item name="android:colorAccent">@color/accent</item>
        <item name="colorControlActivated">@color/accent</item>
        <item name="alertDialogTheme">@style/Theme.Ledger.Dialog.Alert</item>
        <item name="android:datePickerDialogTheme">@style/Theme.Ledger.Picker</item>
        <item name="android:timePickerDialogTheme">@style/Theme.Ledger.Picker</item>
        <item name="android:fontFamily">sans</item>
        <item name="android:colorBackground">@color/bg</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
    </style>
    <style name="Theme.Ledger" parent="Base.Theme.Ledger">
        <item name="android:navigationBarColor">@color/bg</item>
    </style>
    <style name="Theme.Ledger.Dialog" parent="Theme.AppCompat.DayNight.Dialog.Alert">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:backgroundDimEnabled">true</item>
        <item name="colorAccent">@color/accent</item>
        <item name="android:alertDialogTheme">@style/Theme.Ledger.Dialog.Alert</item>
    </style>
    <style name="Theme.Ledger.Dialog.Alert" parent="Theme.AppCompat.DayNight.Dialog.Alert">
        <item name="android:windowBackground">@drawable/bg_card</item>
        <item name="android:colorBackground">@color/card</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
        <item name="android:backgroundDimAmount">0.45</item>
        <item name="colorAccent">@color/accent</item>
        <item name="buttonBarPositiveButtonStyle">@style/Ledger.DialogButton</item>
        <item name="buttonBarNegativeButtonStyle">@style/Ledger.DialogButton</item>
        <item name="buttonBarNeutralButtonStyle">@style/Ledger.DialogButton</item>
        <item name="android:buttonBarStyle">@style/Theme.Ledger.Dialog.ButtonBar</item>
    </style>
    <style name="Ledger.DialogButton" parent="Widget.AppCompat.Button.ButtonBar.AlertDialog">
        <item name="android:textColor">@color/accent</item>
        <item name="android:textAllCaps">false</item>
    </style>
    <style name="Theme.Ledger.Picker" parent="android:style/Theme.Material.Light.Dialog.Alert">
        <item name="android:windowLightStatusBar">@bool/light_system_bars</item>
        <item name="android:datePickerStyle">@style/Ledger.DatePicker</item>
        <item name="android:timePickerStyle">@style/Ledger.TimePicker</item>
        <item name="android:windowBackground">@drawable/bg_card</item>
        <item name="android:colorBackground">@color/card</item>
        <item name="android:colorAccent">@color/accent</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
        <item name="android:colorControlNormal">@color/text_secondary</item>
        <item name="android:colorControlActivated">@color/accent</item>
        <item name="android:backgroundDimAmount">0.45</item>
    </style>
    <style name="Ledger.DatePicker" parent="android:style/Widget.Material.DatePicker">
        <item name="android:datePickerMode">spinner</item>
        <item name="android:calendarViewShown">false</item>
        <item name="android:spinnersShown">true</item>
    </style>
    <style name="Ledger.TimePicker" parent="android:style/Widget.Material.TimePicker">
        <item name="android:timePickerMode">spinner</item>
    </style>
    <style name="Theme.Ledger.Dialog.ButtonBar" parent="Widget.AppCompat.ButtonBar.AlertDialog">
        <item name="android:background">@android:color/transparent</item>
    </style>
</resources>
